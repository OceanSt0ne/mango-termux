#!/data/data/com.termux/files/usr/bin/bash
#
# Idempotently re-apply the MangoWM Termux integrations.
#
# The integrations are normally installed by the dedicated helpers under
# termux-compat/. This script re-applies the parts that can change when a new
# Termux package or .deb is installed later: Firefox and terminal .desktop
# entries, the Firefox launcher, native Noctalia, and safe default terminal
# shell configs.
#
# Usage:
#   ./termux-compat/mango-integrate [--quiet] [--check]
#                                    [--no-firefox] [--no-terminals]
set -euo pipefail

prefix="${PREFIX:-/data/data/com.termux/files/usr}"
bin="$prefix/bin"
home="${HOME:-/data/data/com.termux/files/home}"
config="${XDG_CONFIG_HOME:-$home/.config}"

quiet=0
check_only=0
enable_firefox=1
enable_terminals=1

firefox_patched=0
firefox_skipped=0
terminal_restored=0
terminal_skipped=0
configs_created=0
configs_skipped=0
noctalia_rootfs=""

usage() {
	cat <<'EOF'
Re-apply the MangoWM Termux integrations.

Usage:
  ./termux-compat/mango-integrate [options]

Options:
  --quiet         Suppress normal output; warnings/errors still go to stderr.
  --check         Verify wrappers and patched desktop entries; exit nonzero
                  if anything is missing. No files are modified.
  --no-firefox    Do not patch Firefox desktop entries or the launcher.
  --no-terminals  Do not restore terminal desktop entries or write shell configs.
  -h, --help      Show this help.
EOF
}

die() {
	printf 'error: %s\n' "$*" >&2
	exit 1
}

warn() {
	printf 'warning: %s\n' "$*" >&2
}

info() {
	if ((!quiet)); then
		printf '%s\n' "$*"
	fi
}

while (($#)); do
	case "$1" in
		--quiet) quiet=1 ;;
		--check) check_only=1 ;;
		--no-firefox) enable_firefox=0 ;;
		--no-terminals) enable_terminals=0 ;;
		-h|--help) usage; exit 0 ;;
		--) shift; break ;;
		*) die "unknown argument: $1" ;;
	esac
	shift
done

if (($#)); then
	die "unexpected argument: $1"
fi

set_mode_from() {
	local reference="$1"
	local target="$2"
	if chmod --reference="$reference" "$target" 2>/dev/null; then
		return 0
	fi
	local mode
	mode="$(stat -c '%a' "$reference" 2>/dev/null)" || return 0
	chmod "$mode" "$target" 2>/dev/null || true
}

discover_desktop_entries() {
	local dir="$prefix/share/applications"
	if [[ -d "$dir" ]]; then
		find "$dir" -maxdepth 1 -type f -name '*.desktop' -print0 \
			2>/dev/null || true
	fi

	local containers="$prefix/var/lib/proot-distro/containers"
	if [[ -d "$containers" ]]; then
		find "$containers" -type f \
			\( -path '*/rootfs/applications/*.desktop' \
			-o -path '*/rootfs/*/applications/*.desktop' \) \
			-print0 2>/dev/null || true
	fi
}

is_firefox_entry() {
	grep -qi 'firefox' "$1"
}

firefox_direct_status() {
	awk -v wrapper="$prefix/bin/mango-firefox" '
		function basename_of(path,    n, parts) {
			n = split(path, parts, "/")
			return parts[n]
		}
		function token_at(value, pos,    len, start) {
			len = length(value)
			while (pos <= len &&
				(substr(value, pos, 1) == " " || substr(value, pos, 1) == "\t"))
				pos++
			if (pos > len) {
				TOKEN = ""
				TOKEN_START = pos
				TOKEN_END = pos
				return pos
			}
			start = pos
			while (pos <= len &&
				substr(value, pos, 1) != " " && substr(value, pos, 1) != "\t")
				pos++
			TOKEN = substr(value, start, pos - start)
			TOKEN_START = start
			TOKEN_END = pos
			return pos
		}
		function parse_command(value,    pos, first) {
			pos = token_at(value, 1)
			if (TOKEN == "")
				return ""
			first = TOKEN
			if (basename_of(first) == "env") {
				while (1) {
					pos = token_at(value, pos)
					if (TOKEN == "")
						return ""
					if (TOKEN == "--") {
						pos = token_at(value, pos)
						if (TOKEN == "")
							return ""
						CMD_END = TOKEN_END
						return TOKEN
					}
					if (substr(TOKEN, 1, 1) == "-") {
						if (TOKEN == "-u" || TOKEN == "--unset") {
							pos = token_at(value, pos)
							if (TOKEN == "")
								return ""
						}
						continue
					}
					CMD_END = TOKEN_END
					return TOKEN
				}
			}
			CMD_END = TOKEN_END
			return first
		}
		BEGIN { saw = 0; bad = 0 }
		index($0, "Exec=") == 1 {
			value = substr($0, 6)
			sub(/^[[:space:]]+/, "", value)
			command = parse_command(value)
			if (basename_of(command) == "firefox" ||
				basename_of(command) == "mango-firefox") {
				saw = 1
				if (index(value, wrapper) != 1)
					bad = 1
			}
		}
		END {
			if (bad)
				exit 1
			if (saw)
				exit 0
			exit 2
		}
	' "$1"
}

terminal_exec_match() {
	local file="$1"
	local term
	grep -Eq '^Exec=[[:space:]]*/usr/bin/env .*mango-host-run' "$file" &&
		return 0
	for term in kitty kitty-open foot footclient foot-server ghostty; do
		if grep -Eq "^Exec=[[:space:]]*([^[:space:]]*/)?${term}([[:space:]]|\$)" \
			"$file"; then
			return 0
		fi
	done
	return 1
}

terminal_filename_match() {
	local base="${1##*/}"
	base="${base,,}"
	case "$base" in
		kitty*.desktop|foot*.desktop|*ghostty*.desktop) return 0 ;;
	esac
	return 1
}

is_terminal_entry() {
	local file="$1"
	grep -q 'mango-host-run' "$file" && return 0
	terminal_exec_match "$file" && return 0
	terminal_filename_match "$file"
}

backup_once() {
	local file="$1"
	local backup="$file.mango-bak"
	if [[ -e "$backup" || -L "$backup" ]]; then
		return 0
	fi
	if ! cp -a "$file" "$backup" 2>/dev/null; then
		warn "cannot create backup: $backup"
		return 1
	fi
	return 0
}

patch_firefox_desktop() {
	local file="$1"

	local tmp
	tmp="$(mktemp "${file}.tmp.XXXXXX" 2>/dev/null)" || {
		warn "cannot create temporary file for: $file"
		return 0
	}
	if ! awk -v prefix="$prefix" '
		function basename_of(path,    n, parts) {
			n = split(path, parts, "/")
			return parts[n]
		}
		function token_at(value, pos,    len, start) {
			len = length(value)
			while (pos <= len &&
				(substr(value, pos, 1) == " " || substr(value, pos, 1) == "\t"))
				pos++
			if (pos > len) {
				TOKEN = ""
				TOKEN_END = pos
				return pos
			}
			start = pos
			while (pos <= len &&
				substr(value, pos, 1) != " " && substr(value, pos, 1) != "\t")
				pos++
			TOKEN = substr(value, start, pos - start)
			TOKEN_END = pos
			return pos
		}
		function parse_command(value,    pos, first) {
			pos = token_at(value, 1)
			if (TOKEN == "")
				return ""
			first = TOKEN
			if (basename_of(first) == "env") {
				while (1) {
					pos = token_at(value, pos)
					if (TOKEN == "")
						return ""
					if (TOKEN == "--") {
						pos = token_at(value, pos)
						if (TOKEN == "")
							return ""
						CMD_END = TOKEN_END
						return TOKEN
					}
					if (substr(TOKEN, 1, 1) == "-") {
						if (TOKEN == "-u" || TOKEN == "--unset") {
							pos = token_at(value, pos)
							if (TOKEN == "")
								return ""
						}
						continue
					}
					CMD_END = TOKEN_END
					return TOKEN
				}
			}
			CMD_END = TOKEN_END
			return first
		}
		{
			if (index($0, "Exec=") == 1) {
				value = substr($0, 6)
				sub(/^[[:space:]]+/, "", value)
				command = parse_command(value)
				base = basename_of(command)
				if (base == "firefox" || base == "mango-firefox") {
					tail = substr(value, CMD_END)
					print "Exec=" prefix "/bin/mango-firefox" tail
					next
				}
			}
			print
		}
	' "$file" >"$tmp" 2>/dev/null; then
		rm -f "$tmp"
		warn "cannot rewrite: $file"
		return 0
	fi

	if cmp -s "$file" "$tmp"; then
		rm -f "$tmp"
		info "no firefox Exec: $file"
		firefox_skipped=$((firefox_skipped + 1))
		return 0
	fi

	if ! backup_once "$file"; then
		rm -f "$tmp"
		return 0
	fi

	set_mode_from "$file" "$tmp"
	if ! mv "$tmp" "$file" 2>/dev/null; then
		rm -f "$tmp"
		warn "cannot replace: $file"
		return 0
	fi

	info "patched firefox: $file"
	firefox_patched=$((firefox_patched + 1))
	return 0
}

restore_terminal_desktop() {
	local file="$1"
	local backup="$file.mango-bak"
	local tmp

	if [[ -e "$backup" || -L "$backup" ]] &&
		! grep -q 'mango-host-run' "$backup"; then
		tmp="$(mktemp "${file}.tmp.XXXXXX" 2>/dev/null)" || {
			warn "cannot create temporary file for: $file"
			return 0
		}
		if ! cp "$backup" "$tmp" 2>/dev/null; then
			rm -f "$tmp"
			warn "cannot restore: $file"
			return 0
		fi
		set_mode_from "$backup" "$tmp"
		if ! mv "$tmp" "$file" 2>/dev/null; then
			rm -f "$tmp"
			warn "cannot replace: $file"
			return 0
		fi
		info "restored terminal: $file"
		terminal_restored=$((terminal_restored + 1))
		return 0
	fi

	tmp="$(mktemp "${file}.tmp.XXXXXX" 2>/dev/null)" || {
		warn "cannot create temporary file for: $file"
		return 0
	}
	if ! awk -v prefix="$prefix" '
		function basename_of(path,    n, parts) {
			n = split(path, parts, "/")
			return parts[n]
		}
		function token_at(value, pos,    len, start) {
			len = length(value)
			while (pos <= len &&
				(substr(value, pos, 1) == " " || substr(value, pos, 1) == "\t"))
				pos++
			if (pos > len) {
				TOKEN = ""
				TOKEN_START = pos
				TOKEN_END = pos
				return pos
			}
			start = pos
			while (pos <= len &&
				substr(value, pos, 1) != " " && substr(value, pos, 1) != "\t")
				pos++
			TOKEN = substr(value, start, pos - start)
			TOKEN_START = start
			TOKEN_END = pos
			return pos
		}
		function parse_command(value,    pos, first) {
			pos = token_at(value, 1)
			if (TOKEN == "")
				return ""
			first = TOKEN
			if (basename_of(first) == "env") {
				while (1) {
					pos = token_at(value, pos)
					if (TOKEN == "")
						return ""
					if (TOKEN == "--") {
						pos = token_at(value, pos)
						if (TOKEN == "")
							return ""
						CMD_END = TOKEN_END
						return TOKEN
					}
					if (substr(TOKEN, 1, 1) == "-") {
						if (TOKEN == "-u" || TOKEN == "--unset") {
							pos = token_at(value, pos)
							if (TOKEN == "")
								return ""
						}
						continue
					}
					CMD_END = TOKEN_END
					return TOKEN
				}
			}
			CMD_END = TOKEN_END
			return first
		}
		{
			if (index($0, "Exec=") == 1) {
				value = substr($0, 6)
				sub(/^[[:space:]]+/, "", value)
				command = parse_command(value)
				if (basename_of(command) == "mango-host-run") {
					token_at(value, CMD_END)
					if (TOKEN != "") {
						print "Exec=" substr(value, TOKEN_START)
						next
					}
				}
			}
			print
		}
	' "$file" >"$tmp" 2>/dev/null; then
		rm -f "$tmp"
		warn "cannot rewrite: $file"
		return 0
	fi

	if cmp -s "$file" "$tmp"; then
		rm -f "$tmp"
		info "no terminal overlay: $file"
		terminal_skipped=$((terminal_skipped + 1))
		return 0
	fi

	if ! backup_once "$file"; then
		rm -f "$tmp"
		return 0
	fi

	set_mode_from "$file" "$tmp"
	if ! mv "$tmp" "$file" 2>/dev/null; then
		rm -f "$tmp"
		warn "cannot replace: $file"
		return 0
	fi

	info "restored terminal: $file"
	terminal_restored=$((terminal_restored + 1))
	return 0
}

ensure_firefox_launcher() {
	local src="$bin/mango-firefox"
	local dst="$bin/firefox"

	[[ -x "$prefix/lib/firefox/firefox" ]] || return 0

	if [[ ! -x "$src" ]]; then
		warn "cannot install Firefox launcher: missing or not executable: $src"
		return 0
	fi

	if [[ -f "$dst" ]] && cmp -s "$src" "$dst"; then
		info "Firefox launcher already integrated: $dst"
		return 0
	fi

	if [[ -e "$dst" || -L "$dst" ]]; then
		local backup="$dst.mango-bak"
		if [[ ! -e "$backup" && ! -L "$backup" ]]; then
			if ! cp -a "$dst" "$backup" 2>/dev/null; then
				warn "cannot back up Firefox launcher: $dst"
			fi
		fi
	fi

	local tmp
	tmp="$(mktemp "${dst}.tmp.XXXXXX" 2>/dev/null)" || {
		warn "cannot create temporary file for: $dst"
		return 0
	}
	if ! cp -a "$src" "$tmp" 2>/dev/null; then
		rm -f "$tmp"
		warn "cannot copy Firefox launcher: $src"
		return 0
	fi
	set_mode_from "$src" "$tmp"
	if ! mv "$tmp" "$dst" 2>/dev/null; then
		rm -f "$tmp"
		warn "cannot replace Firefox launcher: $dst"
		return 0
	fi

	info "installed Firefox launcher: $dst"
	return 0
}

find_noctalia_rootfs() {
	local base="$prefix/var/lib/proot-distro"
	local candidate
	for candidate in "$base"/installed-rootfs/* "$base"/containers/*/rootfs; do
		[[ -e "$candidate/usr/bin/noctalia" ]] || continue
		printf '%s\n' "$candidate"
		return 0
	done
	return 1
}

install_native_noctalia() {
	[[ -n "$noctalia_rootfs" ]] || return 0

	local src="$bin/mango-noctalia"
	local dst="$bin/noctalia"
	local backup="$dst.proot-bak"
	local tmp

	if [[ ! -x "$src" ]]; then
		info "native Noctalia launcher source is unavailable: $src"
		return 0
	fi

	if [[ ! -L "$dst" && -f "$dst" ]] && cmp -s "$src" "$dst"; then
		info "native Noctalia launcher already installed: $dst"
		return 0
	fi

	if [[ -e "$dst" || -L "$dst" ]] &&
		[[ ! -e "$backup" && ! -L "$backup" ]]; then
		if ! cp -a "$dst" "$backup" 2>/dev/null; then
			warn "cannot back up Noctalia proxy: $dst"
		fi
	fi

	tmp="$(mktemp "${dst}.tmp.XXXXXX" 2>/dev/null)" || {
		warn "cannot create temporary file for: $dst"
		return 0
	}
	if ! cp -a "$src" "$tmp" 2>/dev/null; then
		rm -f "$tmp"
		warn "cannot copy native Noctalia launcher: $src"
		return 0
	fi
	if ! chmod 0755 "$tmp" 2>/dev/null; then
		rm -f "$tmp"
		warn "cannot set mode on native Noctalia launcher: $tmp"
		return 0
	fi
	if ! mv "$tmp" "$dst" 2>/dev/null; then
		rm -f "$tmp"
		warn "cannot replace Noctalia launcher: $dst"
		return 0
	fi

	info "installed native Noctalia launcher: $dst"
	return 0
}

migrate_native_noctalia() {
	[[ -n "$noctalia_rootfs" ]] || return 0

	local rel src dst
	for rel in .config/noctalia .local/state/noctalia .local/share/noctalia; do
		src="$noctalia_rootfs/root/$rel"
		dst="$home/$rel"
		[[ -e "$src" || -L "$src" ]] || continue
		if [[ -e "$dst" || -L "$dst" ]]; then
			info "native Noctalia path exists, not overwriting: $dst"
			continue
		fi
		if ! mkdir -p "${dst%/*}" 2>/dev/null; then
			warn "cannot create Noctalia directory: ${dst%/*}"
			continue
		fi
		if ! mv "$src" "$dst" 2>/dev/null; then
			warn "cannot migrate Noctalia path: $src"
			continue
		fi
		info "migrated Noctalia path: $dst"
	done
}

migrate_noctalia_walls() {
	[[ -n "$noctalia_rootfs" ]] || return 0

	local src="$noctalia_rootfs/root/Walls"
	local dst="$home/Walls"
	local file base tmp

	if [[ -d "$src" ]]; then
		mkdir -p "$dst"
		while IFS= read -r -d '' file; do
			base=${file##*/}
			[[ -e "$dst/$base" ]] && continue
			if ! cp -a "$file" "$dst/$base" 2>/dev/null; then
				warn "cannot copy Noctalia wallpaper: $file"
			else
				info "copied Noctalia wallpaper: $dst/$base"
			fi
		done < <(find "$src" -maxdepth 1 -type f -print0 2>/dev/null)
	fi

	for file in "$home/.local/state/noctalia/settings.toml" \
		"$home/.config/noctalia/settings.toml"; do
		[[ -f "$file" ]] || continue
		grep -q '/root/' "$file" || continue
		if ! backup_once "$file"; then
			continue
		fi
		tmp="$(mktemp "${file}.tmp.XXXXXX" 2>/dev/null)" || {
			warn "cannot create temporary file for: $file"
			continue
		}
		if ! sed "s#/root/#$home/#g" "$file" >"$tmp" 2>/dev/null; then
			rm -f "$tmp"
			warn "cannot rewrite Noctalia paths: $file"
			continue
		fi
		if cmp -s "$file" "$tmp"; then
			rm -f "$tmp"
			continue
		fi
		set_mode_from "$file" "$tmp"
		if ! mv "$tmp" "$file" 2>/dev/null; then
			rm -f "$tmp"
			warn "cannot replace: $file"
			continue
		fi
		info "migrated Noctalia /root paths: $file"
	done
}

ensure_noctalia_child_command() {
	[[ -n "$noctalia_rootfs" ]] || return 0
	[[ -x "$bin/noctalia-exec" ]] || return 0

	local command='launch_apps_custom_command = "noctalia-exec $CMD"'
	local file tmp

	for file in "$home/.local/state/noctalia/settings.toml" \
		"$home/.config/noctalia/settings.toml"; do
		[[ -f "$file" ]] || continue
		grep -Fqx "$command" "$file" && continue

		tmp="$(mktemp "${file}.tmp.XXXXXX" 2>/dev/null)" || {
			warn "cannot create temporary file for: $file"
			continue
		}
		if ! awk -v cmd="$command" '
			BEGIN { in_shell = 0; wrote = 0 }
			/^\[shell\][[:space:]]*$/ {
				in_shell = 1
				print
				if (!wrote) { print cmd; wrote = 1 }
				next
			}
			/^\[/ { in_shell = 0 }
			in_shell && /^[[:space:]]*launch_apps_custom_command[[:space:]]*=/ { next }
			{ print }
			END {
				if (!wrote) {
					print ""
					print "[shell]"
					print cmd
				}
			}
		' "$file" >"$tmp" 2>/dev/null; then
			rm -f "$tmp"
			warn "cannot rewrite Noctalia settings: $file"
			continue
		fi

		if cmp -s "$file" "$tmp"; then
			rm -f "$tmp"
			continue
		fi
		if ! backup_once "$file"; then
			rm -f "$tmp"
			continue
		fi
		set_mode_from "$file" "$tmp"
		if ! mv "$tmp" "$file" 2>/dev/null; then
			rm -f "$tmp"
			warn "cannot replace: $file"
			continue
		fi
		info "routed Noctalia app launches through noctalia-exec: $file"
	done
}

patch_mics_config() {
	local file="$home/.config/mango/mics.conf"
	local tmp

	[[ -f "$file" ]] || return 0
	grep -q 'start-noctalia\.sh' "$file" || return 0

	tmp="$(mktemp "${file}.tmp.XXXXXX" 2>/dev/null)" || {
		warn "cannot create temporary file for: $file"
		return 0
	}
	if ! awk '
		/^[[:space:]]*exec[[:space:]]*=[[:space:]]*.*start-noctalia\.sh/ {
			print "exec=noctalia"
			next
		}
		{ print }
	' "$file" >"$tmp" 2>/dev/null; then
		rm -f "$tmp"
		warn "cannot rewrite: $file"
		return 0
	fi

	if cmp -s "$file" "$tmp"; then
		rm -f "$tmp"
		return 0
	fi

	if ! backup_once "$file"; then
		rm -f "$tmp"
		return 0
	fi

	set_mode_from "$file" "$tmp"
	if ! mv "$tmp" "$file" 2>/dev/null; then
		rm -f "$tmp"
		warn "cannot replace: $file"
		return 0
	fi

	info "patched Noctalia exec: $file"
	return 0
}

patch_start_noctalia_shim() {
	local file="$home/.config/mango/start-noctalia.sh"
	local tmp

	[[ -f "$file" ]] || return 0
	grep -q 'proot-distro' "$file" || return 0

	tmp="$(mktemp "${file}.tmp.XXXXXX" 2>/dev/null)" || {
		warn "cannot create temporary file for: $file"
		return 0
	}
	{
		printf '#!%s/bin/bash\n' "$prefix"
		printf '%s\n' '# Native Noctalia launcher; Noctalia runs directly in Termux.'
		printf 'exec "%s/bin/noctalia" "$@"\n' "$prefix"
	} >"$tmp" 2>/dev/null || {
		rm -f "$tmp"
		warn "cannot write native Noctalia shim: $tmp"
		return 0
	}

	if cmp -s "$file" "$tmp"; then
		rm -f "$tmp"
		return 0
	fi

	if ! backup_once "$file"; then
		rm -f "$tmp"
		return 0
	fi

	if ! chmod 0755 "$tmp" 2>/dev/null; then
		rm -f "$tmp"
		warn "cannot set mode on Noctalia shim: $tmp"
		return 0
	fi
	if ! mv "$tmp" "$file" 2>/dev/null; then
		rm -f "$tmp"
		warn "cannot replace: $file"
		return 0
	fi

	info "rewrote native Noctalia shim: $file"
	return 0
}

create_config_file() {
	local path="$1"
	local content="$2"

	if [[ -e "$path" || -L "$path" ]]; then
		info "skipped existing config: $path"
		configs_skipped=$((configs_skipped + 1))
		return 0
	fi

	local dir="${path%/*}"
	if ! mkdir -p "$dir" 2>/dev/null; then
		warn "cannot create config directory: $dir"
		return 0
	fi
	if ! printf '%s' "$content" >"$path" 2>/dev/null; then
		warn "cannot create config: $path"
		return 0
	fi

	info "created config: $path"
	configs_created=$((configs_created + 1))
	return 0
}

create_terminal_configs() {
	local shell="$bin/fish"
	if [[ ! -x "$shell" ]]; then
		shell="$bin/bash"
	fi

	create_config_file "$config/kitty/kitty.conf" "shell $shell"$'\n'
	create_config_file "$config/foot/foot.ini" "[main]"$'\n'"shell=$shell"$'\n'
	create_config_file "$config/ghostty/config.ghostty" "command = $shell"$'\n'
	ensure_terminal_shell "$shell"
}

ensure_terminal_shell() {
	local shell="$1" file

	file="$config/kitty/kitty.conf"
	if [[ -f "$file" ]] && ! grep -Eq '^[[:space:]]*shell[[:space:]]+' "$file"; then
		if printf 'shell %s\n' "$shell" >>"$file" 2>/dev/null; then
			info "set kitty shell: $file"
		else
			warn "cannot update kitty config: $file"
		fi
	fi

	file="$config/ghostty/config.ghostty"
	if [[ -f "$file" ]] && ! grep -Eq '^[[:space:]]*command[[:space:]]*=' "$file"; then
		if printf 'command = %s\n' "$shell" >>"$file" 2>/dev/null; then
			info "set ghostty command: $file"
		else
			warn "cannot update ghostty config: $file"
		fi
	fi

	file="$config/foot/foot.ini"
	if [[ -f "$file" ]] && grep -q '^\[main\]' "$file" &&
		! grep -Eq '^[[:space:]]*shell[[:space:]]*=' "$file"; then
		if printf 'shell=%s\n' "$shell" >>"$file" 2>/dev/null; then
			info "set foot shell: $file"
		else
			warn "cannot update foot config: $file"
		fi
	fi
}

remove_legacy_host_bridge() {
	if [[ -e "$bin/mango-host-run" ]]; then
		rm -f "$bin/mango-host-run" &&
			info "removed legacy host bridge: $bin/mango-host-run"
	fi
}

required_wrappers() {
	printf '%s\n' mango-firefox mango-gpu-run
	if [[ -n "$noctalia_rootfs" ]]; then
		printf '%s\n' mango-noctalia noctalia-exec
	fi
}

warn_missing_wrappers() {
	local wrapper
	while IFS= read -r wrapper; do
		if [[ ! -x "$bin/$wrapper" ]]; then
			warn "wrapper is missing or not executable: $bin/$wrapper"
		fi
	done < <(required_wrappers)
}

run_check() {
	local failed=0
	local wrapper
	while IFS= read -r wrapper; do
		if [[ -x "$bin/$wrapper" ]]; then
			info "OK: wrapper: $bin/$wrapper"
		else
			printf 'FAIL: wrapper is missing or not executable: %s\n' \
				"$bin/$wrapper" >&2
			failed=1
		fi
	done < <(required_wrappers)

	if [[ -n "$noctalia_rootfs" ]] && [[ -x "$bin/mango-noctalia" ]]; then
		if [[ ! -L "$bin/noctalia" && -f "$bin/noctalia" ]] &&
			cmp -s "$bin/mango-noctalia" "$bin/noctalia"; then
			info "OK: native Noctalia launcher: $bin/noctalia"
		else
			printf 'FAIL: native Noctalia launcher is not installed: %s\n' \
				"$bin/noctalia" >&2
			failed=1
		fi
	fi

	if ((enable_firefox)); then
		local -A seen=()
		local file rc
		while IFS= read -r -d '' file; do
			[[ -n "$file" ]] || continue
			[[ -f "$file" ]] || continue
			[[ -z "${seen[$file]+x}" ]] || continue
			seen[$file]=1
			is_firefox_entry "$file" || continue
			if firefox_direct_status "$file"; then
				info "OK: firefox entry: $file"
			else
				rc=$?
				if ((rc == 2)); then
					info "OK: no firefox Exec: $file"
				else
					printf 'FAIL: firefox entry is not a direct wrapper: %s\n' \
						"$file" >&2
					failed=1
				fi
			fi
		done < <(discover_desktop_entries)

		if [[ -x "$prefix/lib/firefox/firefox" ]]; then
			if [[ -f "$bin/firefox" ]] &&
				cmp -s "$bin/mango-firefox" "$bin/firefox"; then
				info "OK: Firefox launcher: $bin/firefox"
			else
				printf 'FAIL: Firefox launcher is not integrated: %s\n' \
					"$bin/firefox" >&2
				failed=1
			fi
		fi
	fi

	if ((enable_terminals)); then
		local -A seen=()
		local file
		while IFS= read -r -d '' file; do
			[[ -n "$file" ]] || continue
			[[ -f "$file" ]] || continue
			[[ -z "${seen[$file]+x}" ]] || continue
			seen[$file]=1
			is_terminal_entry "$file" || continue
			if grep -q 'mango-host-run' "$file"; then
				printf 'FAIL: terminal entry still uses the host bridge: %s\n' \
					"$file" >&2
				failed=1
			else
				info "OK: terminal entry: $file"
			fi
		done < <(discover_desktop_entries)
	fi

	if ((failed)); then
		printf 'mango-integrate: check failed\n' >&2
		return 1
	fi

	info "mango-integrate: check passed"
	return 0
}

noctalia_rootfs="$(find_noctalia_rootfs 2>/dev/null || true)"

if ((check_only)); then
	run_check
	exit $?
fi

warn_missing_wrappers

if ((enable_firefox)); then
	declare -A firefox_seen=()
	while IFS= read -r -d '' file; do
		[[ -n "$file" ]] || continue
		[[ -f "$file" ]] || continue
		[[ -z "${firefox_seen[$file]+x}" ]] || continue
		firefox_seen[$file]=1
		is_firefox_entry "$file" || continue
		patch_firefox_desktop "$file"
	done < <(discover_desktop_entries)

	ensure_firefox_launcher
fi

if ((enable_terminals)); then
	declare -A terminal_seen=()
	while IFS= read -r -d '' file; do
		[[ -n "$file" ]] || continue
		[[ -f "$file" ]] || continue
		[[ -z "${terminal_seen[$file]+x}" ]] || continue
		terminal_seen[$file]=1
		is_terminal_entry "$file" || continue
		grep -q 'mango-host-run' "$file" || continue
		restore_terminal_desktop "$file"
	done < <(discover_desktop_entries)

	create_terminal_configs
fi

remove_legacy_host_bridge
install_native_noctalia
ensure_noctalia_child_command
migrate_native_noctalia
migrate_noctalia_walls
patch_mics_config
patch_start_noctalia_shim

info "mango-integrate: firefox=${firefox_patched} patched/${firefox_skipped} skipped; terminals=${terminal_restored} restored/${terminal_skipped} skipped; configs=${configs_created} created/${configs_skipped} skipped"
