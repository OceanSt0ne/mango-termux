#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

PREFIX=/data/data/com.termux/files/usr
HOME=/data/data/com.termux/files/home
TMPDIR=$PREFIX/tmp
XDG_RUNTIME_DIR=$PREFIX/tmp
PATH=$PREFIX/bin:/system/bin:/system/xbin
SHELL=$PREFIX/bin/fish
[[ -x $SHELL ]] || SHELL=$PREFIX/bin/bash

clear_foreign_env() {
	unset LD_LIBRARY_PATH LD_PRELOAD LIBGL_DRIVERS_PATH GBM_BACKENDS_PATH \
		MESA_LOADER_DRIVER_OVERRIDE GALLIUM_DRIVER VK_DRIVER_FILES \
		VK_ICD_FILENAMES __EGL_VENDOR_LIBRARY_DIRS \
		__EGL_VENDOR_LIBRARY_FILENAMES FD_KGSL_DMABUF EGL_PLATFORM
	local name
	while IFS= read -r name; do
		unset "$name"
	done < <(compgen -v PROOT_ || true)
}

clear_foreign_env

requested_rootfs=${NOCTALIA_ROOTFS:-}

if [[ -n $requested_rootfs ]]; then
	rootfs=${requested_rootfs%/}
	if [[ ! -x $rootfs/usr/bin/noctalia || ! -e $rootfs/lib/ld-linux-aarch64.so.1 ]]; then
		echo "error: NOCTALIA_ROOTFS=$requested_rootfs lacks usr/bin/noctalia or lib/ld-linux-aarch64.so.1" >&2
		exit 1
	fi
else
	rootfs=
	for candidate in "$PREFIX"/var/lib/proot-distro/installed-rootfs/* \
		"$PREFIX"/var/lib/proot-distro/containers/*/rootfs; do
		[[ -d $candidate ]] || continue
		if [[ -x $candidate/usr/bin/noctalia && -e $candidate/lib/ld-linux-aarch64.so.1 ]]; then
			rootfs=$candidate
			break
		fi
	done
	if [[ -z $rootfs ]]; then
		echo "error: no usable rootfs found; need usr/bin/noctalia and lib/ld-linux-aarch64.so.1" >&2
		echo "  searched $PREFIX/var/lib/proot-distro/installed-rootfs/*" >&2
		echo "  searched $PREFIX/var/lib/proot-distro/containers/*/rootfs" >&2
		echo "  set NOCTALIA_ROOTFS to override" >&2
		exit 1
	fi
fi

loader=$PREFIX/glibc/lib/ld-linux-aarch64.so.1
if [[ ! -e $loader ]]; then
	echo "error: Termux glibc loader not found at $loader" >&2
	exit 1
fi

libstdcpp=$rootfs/usr/lib/libstdc++.so.6
if [[ ! -e $libstdcpp ]]; then
	echo "error: rootfs libstdc++ not found at $libstdcpp" >&2
	exit 1
fi
libstdcpp=$(readlink -f "$libstdcpp")

native_dir=$PREFIX/libexec/mango-termux
native_bin=$native_dir/noctalia-native
native_stamp=$native_bin.rootfs
rootfs_lib_dir=$native_dir/rootfs-libs
egl_vendor_dir=$native_dir/egl_vendor.d
vulkan_icd_dir=$native_dir/vulkan/icd.d

ensure_rootfs_runtime() {
	mkdir -p "$rootfs_lib_dir" "$egl_vendor_dir" "$vulkan_icd_dir"
	local lib dir
	for lib in libEGL_mesa.so.0 libgallium-27.0.0-arch1.92.so \
		libLLVM.so.23.1 libgbm.so.1 libxml2.so.16 libstdc++.so.6 \
		libgcc_s.so.1 libz.so.1 libzstd.so.1 libffi.so.8 \
		libSPIRV-Tools.so libsensors.so.5 libicuuc.so.78 \
		libicudata.so.78 libedit.so.0 libncursesw.so.6 \
		libwayland-client.so.0 libwayland-server.so.0 libwayland-egl.so.1 \
		libexpat.so.1 libdrm.so.2 libdisplay-info.so.2 libudev.so.1 \
		libvulkan_freedreno.so; do
		for dir in "$rootfs/usr/lib" "$rootfs/usr/lib/aarch64-linux-gnu"; do
			if [[ -e "$dir/$lib" ]]; then
				ln -sfn "$dir/$lib" "$rootfs_lib_dir/$lib"
				break
			fi
		done
	done
	printf '{"file_format_version":"1.0.0","ICD":{"library_path":"%s/usr/lib/libEGL_mesa.so.0"}}\n' \
		"$rootfs" >"$egl_vendor_dir/50_mesa.json"
	printf '{"file_format_version":"1.0.0","ICD":{"library_path":"%s/usr/lib/libvulkan_freedreno.so"}}\n' \
		"$rootfs" >"$vulkan_icd_dir/freedreno_icd.aarch64.json"
}

ensure_rootfs_runtime
rootfs_rpath=$rootfs_lib_dir:$PREFIX/glibc/lib:$rootfs/usr/lib:$rootfs/lib
for dir in "$rootfs/usr/lib/aarch64-linux-gnu" "$rootfs/lib/aarch64-linux-gnu"; do
	[[ -d "$dir" ]] && rootfs_rpath=$rootfs_rpath:$dir
done

ensure_native_binary() {
	if ! command -v patchelf >/dev/null 2>&1; then
		echo "error: patchelf is required to prepare the native Noctalia binary" >&2
		echo "  pkg install patchelf" >&2
		exit 1
	fi
	if [[ -x $native_bin && -f $native_stamp ]] &&
		[[ $(<"$native_stamp") == "$rootfs" ]] &&
		[[ $native_bin -nt $rootfs/usr/bin/noctalia ]] &&
		[[ $native_bin -nt $libstdcpp ]] &&
		[[ $native_bin -nt $loader ]] &&
		[[ $native_bin -nt ${BASH_SOURCE[0]} ]]; then
		return 0
	fi
	mkdir -p "$native_dir"
	local tmp
	tmp=$(mktemp "$native_dir/.noctalia-native.XXXXXX")
	if ! cp "$rootfs/usr/bin/noctalia" "$tmp"; then
		rm -f "$tmp"
		echo "error: cannot copy $rootfs/usr/bin/noctalia" >&2
		exit 1
	fi
	chmod 0755 "$tmp"
	if ! patchelf --set-interpreter "$loader" --force-rpath \
		--set-rpath "$rootfs_rpath" "$tmp"; then
		rm -f "$tmp"
		echo "error: patchelf failed to prepare the native Noctalia binary" >&2
		exit 1
	fi
	if ! patchelf --replace-needed libstdc++.so.6 "$libstdcpp" "$tmp"; then
		rm -f "$tmp"
		echo "error: patchelf failed to pin rootfs libstdc++" >&2
		exit 1
	fi
	mv -f "$tmp" "$native_bin"
	printf '%s\n' "$rootfs" >"$native_stamp"
}

ensure_native_binary

session=$PREFIX/tmp/mango-session.env
if [[ -f $session ]]; then
	set -a
	source "$session"
	set +a
fi

export HOME PREFIX TMPDIR XDG_RUNTIME_DIR PATH SHELL
clear_foreign_env

# These point inside the rootfs and are required by Noctalia itself.  Child
# applications are started through noctalia-exec, which drops them again.
export __EGL_VENDOR_LIBRARY_DIRS=$egl_vendor_dir
unset __EGL_VENDOR_LIBRARY_FILENAMES
export VK_ICD_FILENAMES=$vulkan_icd_dir/freedreno_icd.aarch64.json
export VK_DRIVER_FILES=$VK_ICD_FILENAMES
if [[ -d $rootfs/usr/lib/dri ]]; then
	export LIBGL_DRIVERS_PATH=$rootfs/usr/lib/dri
fi
if [[ -d $rootfs/usr/lib/gbm ]]; then
	export GBM_BACKENDS_PATH=$rootfs/usr/lib/gbm
fi

: "${WAYLAND_DISPLAY:=wayland-0}"
: "${DISPLAY:=:0}"
export WAYLAND_DISPLAY DISPLAY
export XDG_CONFIG_HOME=$HOME/.config
export XDG_STATE_HOME=$HOME/.local/state
export XDG_DATA_HOME=$HOME/.local/share

extend_paths() {
	local out=$1 dir
	local -a extra
	IFS=: read -ra extra <<< "${2:-}"
	for dir in ${extra[@]+"${extra[@]}"}; do
		[[ -n $dir ]] || continue
		case ":$out:" in
			*":$dir:"*) continue ;;
		esac
		out=$out:$dir
	done
	printf '%s' "$out"
}

# Children must only see native Termux data/config roots.  The rootfs asset
# bundle is exposed separately through NOCTALIA_ASSETS_DIR, so rootfs paths
# never leak into applications launched from Noctalia.
XDG_DATA_DIRS=$PREFIX/share
XDG_CONFIG_DIRS=$PREFIX/etc/xdg
export XDG_DATA_DIRS XDG_CONFIG_DIRS

if [[ -z ${TERM:-} || $TERM == dumb ]]; then
	TERM=xterm-256color
fi
export TERM
if [[ -d $PREFIX/share/terminfo ]]; then
	export TERMINFO=$PREFIX/share/terminfo
fi
export XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-wayland}

export NOCTALIA_ASSETS_DIR=$rootfs/usr/share/noctalia/assets
if [[ -d $PREFIX/etc/fonts ]]; then
	export FONTCONFIG_PATH=$PREFIX/etc/fonts
fi

if [[ -z ${DBUS_SESSION_BUS_ADDRESS:-} && -z ${MANGO_NOCTALIA_DBUS_WRAPPED:-} ]]; then
	if dbus_run=$(command -v dbus-run-session); then
		self=${BASH_SOURCE[0]}
		if [[ $self != /* ]]; then
			if [[ $self == */* ]]; then
				self=$PWD/$self
			else
				self=$(command -v -- "$self" || printf '%s' "$PWD/$self")
			fi
		fi
		export MANGO_NOCTALIA_DBUS_WRAPPED=1
		exec "$dbus_run" -- "$self" "$@"
	fi
fi

exec "$native_bin" "$@"
